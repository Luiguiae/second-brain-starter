# URL pública del deploy (Railway asigna un dominio *.up.railway.app, o el
# dominio custom que configures). Se usa para:
#   1. Declarar `servers` en el OpenAPI generado (requerido por Custom GPT
#      Actions para saber a qué host llamar) — ver app/main.py.
#   2. Agregar el host a la allowlist de Host/Origin del canal MCP
#      (protección DNS rebinding del SDK) — ver app/main.py.
# Opcional: en desarrollo local se omite y ambos comportamientos caen a sus
# defaults (sin `servers` en OpenAPI; solo localhost/127.0.0.1 permitidos
# en /mcp).
PUBLIC_BASE_URL=https://tu-app.up.railway.app
